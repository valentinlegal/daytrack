# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# La base vit dans db/, le volume que la v1 utilisait déjà : un fichier par
# environnement, daytrack_prod.db chez l'utilisateur. Celui de la v1 s'appelle
# data_prod.db, et la v2 n'y écrit jamais.
DATABASE_URL="sqlite:///%kernel.project_dir%/db/daytrack_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

# Les adresses du proxy auquel Symfony fait confiance, quand DayTrack est servi
# derrière un proxy qui porte le HTTPS et le nom de domaine : « private_ranges »
# pour un proxy sur la même machine ou le même réseau Docker. Vide : personne.
# « private_ranges » croit aussi tout poste du réseau local qui joindrait le port
# directement : aucun contrôle ne doit donc reposer sur l'adresse du client.
TRUSTED_PROXIES=

# Le fuseau de l'utilisateur, d'où le serveur tire le jour qu'il est : le conteneur
# vit en heure universelle, et à 00:30 à Paris il y est encore la veille.
DAYTRACK_TIMEZONE=Europe/Paris

# La clé propre à cette installation, d'où DayTrack tire celle qui chiffre le jeton
# Jira et le secret de Symfony (src/Installation/). Il la crée lui-même au premier
# démarrage, dans /data, le volume du certificat : hors de la base, pour qu'une copie
# de la base ne livre pas le jeton. Elle ne se remplace jamais : une autre clé rendrait
# le jeton enregistré illisible, et il faudrait le recoller dans les réglages.
DAYTRACK_KEY_FILE=/data/daytrack/installation.key

# La passerelle d'Atlassian, par où passent les jetons à périmètres. Seul le
# développement la remplace, par le Jira simulé.
JIRA_GATEWAY_URL=https://api.atlassian.com

# La base de la v1, dans le même volume que celle de la v2 : lue une fois, au premier
# démarrage, jamais modifiée.
DAYTRACK_V1_DATABASE="%kernel.project_dir%/db/data_%kernel.environment%.db"
# Posé par le point d'entrée de l'image quand l'ancien docker-compose.yml est encore
# là : « default » tel que la v1 le fournissait, « custom » s'il avait été changé.
DAYTRACK_OLD_COMPOSE=
