{
    "name": "daytrack",
    "license": "SEE LICENSE IN LICENSE",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Edge versions",
        "last 2 Firefox versions",
        "last 2 Safari versions"
    ],
    "scripts": {
        "dev": "encore dev",
        "watch": "encore dev --watch",
        "build": "encore production",
        "lint": "tsc --noEmit && eslint --max-warnings=0 assets tests \"*.{js,ts}\" && stylelint --max-warnings=0 \"assets/**/*.css\" && prettier --check .",
        "format": "prettier --write . && eslint --fix assets tests \"*.{js,ts}\" && stylelint --fix \"assets/**/*.css\"",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "canvas-confetti": "1.9.4",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@babel/core": "8.0.10",
        "@babel/preset-env": "8.0.7",
        "@babel/preset-react": "8.0.1",
        "@babel/preset-typescript": "8.0.7",
        "@eslint-react/eslint-plugin": "5.28.8",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@symfony/webpack-encore": "7.2.0",
        "@tailwindcss/node": "4.3.3",
        "@tailwindcss/postcss": "4.3.3",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.14.0",
        "eslint-plugin-jsx-a11y-x": "0.2.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "fast-check": "4.10.2",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "postcss": "8.5.32",
        "postcss-loader": "8.2.1",
        "prettier": "3.9.10",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "stylelint-declaration-strict-value": "1.12.1",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "webpack": "5.112.2",
        "webpack-cli": "7.3.1"
    },
    "overrides": {
        "minimatch": "11.0.3"
    }
}
